<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#10000000">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivCategoryIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_icon"
            android:padding="10dp"
            android:src="@drawable/ic_food"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#6200EE"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvEntryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1E1B18"
            app:layout_constraintEnd_toStartOf="@+id/tvCaloriesBadge"
            app:layout_constraintStart_toEndOf="@+id/ivCategoryIcon"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Oatmeal with Berries" />

        <TextView
            android:id="@+id/tvCategoryDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="#757575"
            app:layout_constraintEnd_toStartOf="@+id/tvCaloriesBadge"
            app:layout_constraintStart_toEndOf="@+id/ivCategoryIcon"
            app:layout_constraintTop_toBottomOf="@+id/tvEntryName"
            tools:text="Food • Mar 30, 2026" />

        <TextView
            android:id="@+id/tvNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="#9E9E9E"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintEnd_toStartOf="@+id/tvCaloriesBadge"
            app:layout_constraintStart_toEndOf="@+id/ivCategoryIcon"
            app:layout_constraintTop_toBottomOf="@+id/tvCategoryDate"
            tools:text="Note: Healthy breakfast" />

        <TextView
            android:id="@+id/tvCaloriesBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_calorie_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="#6200EE"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="350 Calories" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
